# EVE Frontier Club Frontend - Configuration Template
# Copy to .env and configure for your environment
# For local development, defaults below should work out of the box

# Server Configuration
# PORT: Dev server port (default 8080 for Jaspr dev server)
# HOST: Listen address (0.0.0.0 for all interfaces, localhost for local only)
PORT=8080
HOST=localhost

# Backend API Configuration
# BACKEND_URL: URL where the backend Trust Index API is running
# For local development: http://localhost:8081 (if running locally)
# Leave empty if backend is not available yet
BACKEND_URL=http://localhost:8081
API_TIMEOUT=30000

# Application Settings
APP_NAME=EVE Frontier Club
APP_VERSION=0.0.1

# Environment Type (development, staging, production)
# Controls logging level, error reporting, and feature availability  
ENVIRONMENT=development

# Feature Flags - Enable/disable features for testing
ENABLE_ANALYTICS=true
ENABLE_TRUST_INDEX=true
ENABLE_LEADERBOARD=true

# Logging Configuration  
LOG_LEVEL=info
LOG_FORMAT=json

# Notes:
# - For local development with docker-compose: use services names (e.g., backend:8081)
# - For local CLI development: use localhost:PORT
# - See CONTRIBUTING.md for setup instructions
# - Never commit .env file (it's in .gitignore)
